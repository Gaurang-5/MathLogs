generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id                        String                     @id @default(uuid())
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  slug                      String?                    @unique
  aboutUs                   String?
  websiteConfig             Json?
  config                    Json?                      @default("{\"subjects\": [\"Math\", \"Science\"], \"allowedClasses\": [\"9\", \"10\"], \"requiresGrades\": true}")
  plan                      Tier                       @default(FREE)
  email                     String?
  phoneNumber               String?
  teacherName               String?
  status                    String                     @default("ACTIVE")
  suspensionReason          String?
  planExpiryDate            DateTime?
  planStartDate             DateTime?
  razorpayOrderId           String?
  razorpaySubscriptionId    String?
  areRegistrationsPaused    Boolean                    @default(false)
  admins                    Admin[]
  batches                   Batch[]
  invites                   InviteToken[]
  students                  Student[]
  tests                     Test[]
  attendanceRecords         AttendanceRecord[]
  attendanceSweepRuns       AttendanceSweepRun[]
  studentLeads              StudentLead[]
  systemLogs                SystemLog[]
  upiPaymentVerifications   UpiPaymentVerification[]
  onlineQuizzes             OnlineQuiz[]
  quizCredits               Int                        @default(0)
  isQuizOnly                Boolean                    @default(false)
  isPubliclyListed          Boolean                    @default(false)
  isExclusive               Boolean                    @default(false)
  isVerified                Boolean                    @default(false)
  publicPhone               String?
  whatsappPhone             String?
  city                      String?
  area                      String?
  address                   String?
  tagline                   String?
  subjectsOffered           Json?
  classesOffered            Json?
  logoUrl                   String?
  googlePlaceId             String?
  googleMapsUrl             String?
  googleRating              Float?
  googleReviewCount         Int?
  googleReviews             Json?
  googlePhotos              Json?
  googleLastSyncedAt        DateTime?
  reviews                   Review[]
  leadInquiries             LeadInquiry[]
  ownershipStatus           String                     @default("UNCLAIMED")
  claimedPhone              String?
  claimedAt                 DateTime?
  marketplaceClaims         MarketplaceClaim[]
  marketplaceAuditLogs      MarketplaceAuditLog[]
  superAdminSupportSessions SuperAdminSupportSession[]
}

model InviteToken {
  id          String    @id @default(uuid())
  token       String    @unique
  instituteId String
  isUsed      Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id])
}

model Admin {
  id                           String                        @id @default(uuid())
  username                     String                        @unique
  password                     String
  passwordVersion              Int                           @default(1)
  instituteId                  String?
  role                         String                        @default("INSTITUTE_ADMIN")
  institute                    Institute?                    @relation(fields: [instituteId], references: [id])
  batches                      Batch[]
  tests                        Test[]
  manualAttendanceRecords      AttendanceRecord[]            @relation("ManualAttendanceBy")
  refreshTokens                RefreshToken[]
  onlineQuizzes                OnlineQuiz[]
  marketplaceClaimsDecided     MarketplaceClaim[]            @relation("MarketplaceClaimsDecided")
  marketplaceAuditLogsAuthored MarketplaceAuditLog[]         @relation("MarketplaceAuditLogsAuthored")
  superAdminAuditLogs          SuperAdminAuditLog[]
  superAdminReauthChallenges   SuperAdminReauthChallenge[]
  superAdminSupportSessions    SuperAdminSupportSession[]
  authenticationEvents         AuthenticationEvent[]
  adminSessions                AdminSession[]
  superAdminIdempotencyRecords SuperAdminIdempotencyRecord[]
}

model Batch {
  id                  String               @id @default(uuid())
  name                String
  subject             String?
  className           String?
  timeSlot            String?
  feeAmount           Float                @default(0)
  whatsappGroupLink   String?
  autoSendWelcome     Boolean              @default(false)
  isRegistrationOpen  Boolean              @default(true)
  isRegistrationEnded Boolean              @default(false)
  batchNumber         Int?
  teacherId           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  instituteId         String?
  institute           Institute?           @relation(fields: [instituteId], references: [id])
  teacher             Admin?               @relation(fields: [teacherId], references: [id])
  feeInstallments     FeeInstallment[]
  students            Student[]
  attendanceRecords   AttendanceRecord[]
  attendanceSweepRuns AttendanceSweepRun[]
  studentLeads        StudentLead[]
  tests               Test[]
  sharedTests         Test[]               @relation("TestBatches")
  onlineQuizzes       OnlineQuiz[]
  sharedOnlineQuizzes OnlineQuiz[]         @relation("OnlineQuizBatches")

  @@index([teacherId, className])
  @@index([instituteId])
}

model Student {
  id                      String                     @id @default(uuid())
  humanId                 String?
  name                    String
  parentName              String
  parentWhatsapp          String
  parentEmail             String?
  status                  String                     @default("PENDING") // PENDING, ACTIVE, LEFT
  leaveReason             String?
  leftAt                  DateTime?
  batchId                 String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  schoolName              String?
  additionalData          Json?
  instituteId             String?
  feePayments             FeePayment[]
  feeInstallments         FeeInstallment[]
  feeAssignments          FeeInstallmentAssignment[]
  fees                    FeeRecord[]
  marks                   Mark[]
  attendanceRecords       AttendanceRecord[]
  batch                   Batch?                     @relation(fields: [batchId], references: [id])
  institute               Institute?                 @relation(fields: [instituteId], references: [id])
  balance                 StudentBalance?
  upiPaymentVerifications UpiPaymentVerification[]
  quizSubmissions         QuizSubmission[]

  @@unique([humanId, instituteId])
  @@unique([name, parentWhatsapp, batchId], name: "student_natural_key")
  @@index([batchId])
  @@index([status])
  @@index([name])
  @@index([batchId, status])
  @@index([createdAt])
  @@index([instituteId, status])
  @@index([instituteId, createdAt])
  @@index([instituteId, parentWhatsapp])
}

model FeeRecord {
  id        String   @id @default(uuid())
  amount    Float
  date      DateTime @default(now())
  status    String   @default("PAID")
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([date])
}

model Test {
  id          String     @id @default(uuid())
  name        String
  subject     String
  className   String?
  date        DateTime
  maxMarks    Float
  teacherId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  instituteId String?
  batchId     String?
  isQuiz      Boolean    @default(false)
  marks       Mark[]
  institute   Institute? @relation(fields: [instituteId], references: [id])
  teacher     Admin?     @relation(fields: [teacherId], references: [id])
  batch       Batch?     @relation(fields: [batchId], references: [id])
  batches     Batch[]    @relation("TestBatches")

  @@index([teacherId])
  @@index([date])
  @@index([instituteId])
  @@index([batchId])
}

model Mark {
  id        String  @id @default(uuid())
  score     Float
  studentId String
  testId    String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
  @@index([testId])
  @@index([studentId])
}

model FeeInstallment {
  id                      String                     @id @default(uuid())
  name                    String
  amount                  Float
  batchId                 String
  studentId               String?
  createdAt               DateTime                   @default(now())
  batch                   Batch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student                 Student?                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments                FeePayment[]
  assignments             FeeInstallmentAssignment[]
  upiPaymentVerifications UpiPaymentVerification[]

  @@index([batchId])
  @@index([studentId])
}

model FeePayment {
  id            String         @id @default(uuid())
  date          DateTime       @default(now())
  amountPaid    Float
  studentId     String
  installmentId String
  createdAt     DateTime       @default(now())
  installment   FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([installmentId])
  @@index([studentId, installmentId])
  @@index([date])
  @@index([date, installmentId])
}

model FeeInstallmentAssignment {
  id            String         @id @default(uuid())
  studentId     String
  installmentId String
  createdAt     DateTime       @default(now())
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installment   FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, installmentId])
  @@index([studentId])
  @@index([installmentId])
}

model StudentBalance {
  studentId       String    @id
  totalFee        Float     @default(0)
  totalPaid       Float     @default(0)
  balance         Float     @default(0)
  lastPaymentDate DateTime?
  updatedAt       DateTime  @default(now())
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([balance], map: "idx_balance_desc")
  @@index([updatedAt])
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  studentId         String
  batchId           String
  instituteId       String
  attendanceDate    DateTime
  checkedInAt       DateTime         @default(now())
  photoStorageKey   String?
  photoUrl          String?
  photoUrlExpiresAt DateTime?
  photoMimeType     String?
  note              String?
  source            AttendanceSource @default(KIOSK)
  manualMarkedById  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch             Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute         Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  manualMarkedBy    Admin?           @relation("ManualAttendanceBy", fields: [manualMarkedById], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([batchId, attendanceDate, checkedInAt])
  @@index([instituteId, attendanceDate, checkedInAt])
}

model AttendanceSweepRun {
  id             String    @id @default(uuid())
  batchId        String
  instituteId    String
  attendanceDate DateTime
  scheduledFor   DateTime
  status         String    @default("COMPLETED")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([batchId, attendanceDate])
  @@index([scheduledFor])
  @@index([instituteId, attendanceDate])
}

model IdCounter {
  prefix String @id
  seq    Int
}

model EmailJob {
  id          String    @id @default(uuid())
  recipient   String
  subject     String
  body        String
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  options     Json?
  instituteId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model WhatsappJob {
  id                    String    @id @default(uuid())
  recipient             String
  templateId            String
  data                  Json
  status                JobStatus @default(PENDING)
  attempts              Int       @default(0)
  maxAttempts           Int       @default(3)
  error                 String?
  messageId             String?
  instituteId           String?
  marketplaceEntityType String?
  marketplaceEntityId   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, attempts, createdAt], map: "idx_whatsapp_queue")
  @@index([marketplaceEntityType, marketplaceEntityId, createdAt], map: "idx_whatsapp_marketplace_entity")
}

model OcrScanCache {
  imageHash String   @id
  result    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdminOnboardingLink {
  id                      String   @id @default(uuid())
  token                   String   @unique
  plan                    String
  billingCycle            String?
  maxStudents             Int      @default(100)
  status                  String   @default("PENDING")
  instituteId             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  expiresAt               DateTime
  customPriceMonthlyPaise Int?
  customPriceYearlyPaise  Int?
  discountPercent         Int      @default(0)
  isFreeTrial             Boolean  @default(false)
  trialDays               Int?

  @@index([token])
  @@index([status])
  @@index([createdAt])
}

model OnboardingLead {
  id            String   @id @default(uuid())
  tuitionName   String?
  ownerName     String?
  phone         String   @unique
  email         String?
  planId        String?
  billingCycle  String?
  step          String   @default("STEP_1_STARTED")
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([step])
  @@index([createdAt])
}

// OTP tokens stored in DB instead of in-memory Map
// Survives server restarts and works across multiple Heroku dynos
model OtpToken {
  id         String   @id @default(uuid())
  identifier String // Phone number or email (normalized)
  otp        String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([identifier]) // One active OTP per identifier (upsert replaces old)
  @@index([expiresAt]) // For cleanup queries
}

// Refresh tokens for secure JWT rotation
model RefreshToken {
  id        String        @id @default(uuid())
  token     String        @unique
  adminId   String
  sessionId String?
  admin     Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  session   AdminSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
  @@index([sessionId])
  @@index([expiresAt])
}

model SuperAdminAuditLog {
  id               String   @id @default(uuid())
  action           String
  entityType       String
  entityId         String?
  actorAdminId     String
  instituteId      String?
  reason           String?
  correlationId    String
  supportSessionId String?
  before           Json?
  after            Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  actorAdmin       Admin    @relation(fields: [actorAdminId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([instituteId, createdAt])
  @@index([actorAdminId, createdAt])
}

model SuperAdminReauthChallenge {
  id          String    @id @default(uuid())
  adminId     String
  actionClass String
  otpHash     String
  attempts    Int       @default(0)
  lockedAt    DateTime?
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, actionClass, expiresAt])
}

model SuperAdminSupportSession {
  id          String    @id @default(uuid())
  adminId     String
  instituteId String
  ticketId    String?
  caseId      String?
  reason      String
  expiresAt   DateTime
  endedAt     DateTime?
  endReason   String?
  createdAt   DateTime  @default(now())
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([instituteId, createdAt])
}

model AuthenticationEvent {
  id          String   @id @default(uuid())
  adminId     String?
  eventType   String
  success     Boolean
  ipHash      String?
  deviceLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([eventType, success, createdAt])
}

model AdminSession {
  id            String         @id @default(uuid())
  adminId       String
  deviceLabel   String?
  ipHash        String?
  lastSeenAt    DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  admin         Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([adminId, revokedAt, expiresAt])
}

model SuperAdminIdempotencyRecord {
  id           String   @id @default(uuid())
  actorAdminId String
  scope        String
  key          String
  requestHash  String
  status       String   @default("PENDING")
  response     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actorAdmin   Admin    @relation(fields: [actorAdminId], references: [id], onDelete: Cascade)

  @@unique([actorAdminId, scope, key])
  @@index([expiresAt])
}

enum Tier {
  FREE
  PRO
  ENTERPRISE
  NO_PLAN
  BASIC
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AttendanceSource {
  KIOSK
  MANUAL
}

model SystemAlert {
  id        String    @id @default(uuid())
  title     String
  message   String
  type      String    @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([isActive])
}

model StudentLead {
  id              String    @id @default(uuid())
  studentName     String
  parentName      String
  parentPhone     String
  batchInterestId String?
  status          String    @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  instituteId     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institute       Institute @relation(fields: [instituteId], references: [id])
  batch           Batch?    @relation(fields: [batchInterestId], references: [id])

  @@index([instituteId])
  @@index([status])
}

model SystemLog {
  id          String   @id @default(uuid())
  instituteId String
  action      String // E.g., STUDENT_JOIN, STUDENT_LEAVE, FEE_COLLECTED
  entityId    String? // Optional reference ID
  entityName  String? // Human readable name (e.g., Student Name, Batch Name)
  details     Json? // Optional structured details
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, action])
  @@index([createdAt])
  @@index([instituteId, action, createdAt])
}

model UpiPaymentVerification {
  id              String   @id @default(uuid())
  studentId       String
  instituteId     String
  installmentId   String? // Null if paying custom amount, assigned if paying specific installment
  amount          Float
  storageKey      String // The S3 or local path key of the screenshot
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  paidByName      String? // Name of person who made the payment
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute   Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  installment FeeInstallment? @relation(fields: [installmentId], references: [id])

  @@index([instituteId, status])
  @@index([studentId])
}

model OnlineQuiz {
  id             String    @id @default(uuid())
  title          String
  topic          String?
  difficulty     String?
  timeLimitMins  Int       @default(30)
  totalMarks     Float
  availableFrom  DateTime?
  availableUntil DateTime?
  isFinalized    Boolean   @default(false)
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instituteId String
  batchId     String?
  teacherId   String?

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher   Admin?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  batches              Batch[]          @relation("OnlineQuizBatches")
  studentQuestionCount Int?
  questions            QuizQuestion[]
  submissions          QuizSubmission[]

  @@index([instituteId])
  @@index([batchId])
  @@index([batchId, isFinalized])
  @@index([batchId, createdAt])
  @@index([batchId, availableFrom, availableUntil])
  @@index([teacherId, instituteId, createdAt])
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  questionText  String
  orderIndex    Int     @default(0)
  options       Json // Array of strings
  correctOption String // The exact string of the correct option
  marks         Float   @default(1)
  variantGroup  String? // Null = standalone; same value = sibling variants (one picked per student)

  quiz    OnlineQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, orderIndex])
  @@index([quizId, variantGroup])
}

model QuizSubmission {
  id                String    @id @default(uuid())
  quizId            String
  studentId         String
  score             Float? // Null if not yet graded/submitted
  autoSavedAnswers  Json      @default("{}")
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  shuffledQuestions Json?

  quiz           OnlineQuiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        QuizAnswer[]
  cheatingEvents CheatingEvent[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
  @@index([quizId, submittedAt])
}

model CheatingEvent {
  id           String   @id @default(uuid())
  submissionId String
  eventType    String
  metadata     Json?
  timestamp    DateTime @default(now())

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, timestamp])
  @@index([eventType])
}

model QuizAnswer {
  id             String  @id @default(uuid())
  submissionId   String
  questionId     String
  selectedOption String? // Null if they skipped it
  isCorrect      Boolean @default(false)
  marksObtained  Float   @default(0)

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model ShortUrl {
  id        String   @id // unique random code
  longUrl   String   @db.Text
  createdAt DateTime @default(now())
}

model Review {
  id              String    @id @default(uuid())
  instituteId     String
  reviewerName    String
  reviewerRole    String    @default("Student") // Student, Parent
  rating          Int // 1 to 5
  comment         String    @db.Text
  status          String    @default("APPROVED") // APPROVED, PENDING, REJECTED
  source          String    @default("MATHLOGS") // MATHLOGS, GOOGLE
  googleAuthorUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([rating])
}

model LeadInquiry {
  id                     String    @id @default(uuid())
  instituteId            String
  studentName            String
  phone                  String
  subject                String?
  classGrade             String?
  message                String?   @db.Text
  status                 String    @default("NEW") // NEW, CONTACTED, ENROLLED, CLOSED
  deliveryStatus         String    @default("HELD")
  destinationPhone       String?
  notificationJobId      String?
  notificationSentAt     DateTime?
  notificationError      String?
  notificationRetryCount Int       @default(0)
  releasedAt             DateTime?
  possibleDuplicate      Boolean   @default(false)
  duplicateOfId          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  institute              Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([createdAt])
}

model MarketplaceClaim {
  id                      String    @id @default(uuid())
  instituteId             String
  claimantName            String
  phone                   String
  normalizedPhone         String
  email                   String?
  proofNote               String?   @db.Text
  notes                   String?   @db.Text
  status                  String    @default("NEW")
  verificationNote        String?   @db.Text
  rejectionReason         String?   @db.Text
  contactedAt             DateTime?
  decidedAt               DateTime?
  decidedByAdminId        String?
  communicationStatus     String    @default("NOT_SENT")
  communicationSentAt     DateTime?
  communicationError      String?   @db.Text
  communicationRetryCount Int       @default(0)
  whatsappJobId           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  institute               Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  decidedByAdmin          Admin?    @relation("MarketplaceClaimsDecided", fields: [decidedByAdminId], references: [id])

  @@index([status, createdAt])
  @@index([instituteId, createdAt])
  @@index([instituteId, normalizedPhone, status])
}

model MarketplaceAuditLog {
  id           String     @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  actorAdminId String?
  instituteId  String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime   @default(now())
  actorAdmin   Admin?     @relation("MarketplaceAuditLogsAuthored", fields: [actorAdminId], references: [id])
  institute    Institute? @relation(fields: [instituteId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([instituteId, createdAt])
  @@index([createdAt])
}
