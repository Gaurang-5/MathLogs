generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id                              String                            @id @default(uuid())
  name                            String
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  slug                            String?                           @unique
  aboutUs                         String?
  websiteConfig                   Json?
  config                          Json?                             @default("{\"subjects\": [\"Math\", \"Science\"], \"allowedClasses\": [\"9\", \"10\"], \"requiresGrades\": true}")
  plan                            Tier                              @default(MARKETPLACE)
  email                           String?
  phoneNumber                     String?
  teacherName                     String?
  status                          String                            @default("ACTIVE")
  suspensionReason                String?
  planExpiryDate                  DateTime?
  planStartDate                   DateTime?
  billingCycle                    BillingCycle?
  trialStartedAt                  DateTime?
  trialEndsAt                     DateTime?
  trialUsedAt                     DateTime?
  marketplaceAccessGrantedAt      DateTime?
  includedQuizCredits             Int                               @default(0)
  includedQuizCreditsExpireAt     DateTime?
  lifetimeQuizCredits             Int                               @default(0)
  quizCreditsRenewAt              DateTime?
  canonicalPlanMigratedAt         DateTime?                         @default(now())
  coachingFeeMode                 CoachingFeeMode                  @default(CURRENT_DUE_BASED)
  coachingFeeModeSelectedAt       DateTime?
  timezone                        String                            @default("Asia/Kolkata")
  razorpayOrderId                 String?
  razorpaySubscriptionId          String?
  areRegistrationsPaused          Boolean                           @default(false)
  admins                          Admin[]
  batches                         Batch[]
  invites                         InviteToken[]
  students                        Student[]
  tests                           Test[]
  attendanceRecords               AttendanceRecord[]
  attendanceSweepRuns             AttendanceSweepRun[]
  studentLeads                    StudentLead[]
  systemLogs                      SystemLog[]
  upiPaymentVerifications         UpiPaymentVerification[]
  onlineQuizzes                   OnlineQuiz[]
  quizCredits                     Int                               @default(0)
  isQuizOnly                      Boolean                           @default(false)
  isPubliclyListed                Boolean                           @default(false)
  isExclusive                     Boolean                           @default(false)
  isVerified                      Boolean                           @default(false)
  publicPhone                     String?
  whatsappPhone                   String?
  city                            String?
  area                            String?
  address                         String?
  tagline                         String?
  subjectsOffered                 Json?
  classesOffered                  Json?
  logoUrl                         String?
  googlePlaceId                   String?
  googleMapsUrl                   String?
  googleRating                    Float?
  googleReviewCount               Int?
  googleReviews                   Json?
  googlePhotos                    Json?
  googleLastSyncedAt              DateTime?
  reviews                         Review[]
  leadInquiries                   LeadInquiry[]
  ownershipStatus                 String                            @default("UNCLAIMED")
  claimedPhone                    String?
  claimedAt                       DateTime?
  marketplaceClaims               MarketplaceClaim[]
  marketplaceAuditLogs            MarketplaceAuditLog[]
  superAdminSupportSessions       SuperAdminSupportSession[]
  superAdminBillingOperations     SuperAdminBillingOperation[]
  supportTickets                  SupportTicket[]
  internalCases                   InternalCase[]
  communicationPreference         InstituteCommunicationPreference?
  targetedCommunicationRecipients TargetedCommunicationRecipient[]
  deletionRequests                SuperAdminDeletionRequest[]
  billingPayments                 BillingPayment[]
  planTrialClaims                 PlanTrialClaim[]
  billingWebhookEvents            BillingWebhookEvent[]
  planNotifications               PlanNotification[]
  monthCoverageProfiles           StudentMonthCoverageProfile[]
  monthCoveragePayments           MonthCoveragePayment[]
  monthCoverageAllocations        MonthCoverageAllocation[]
  monthCoverageAuditEvents        MonthCoverageAuditEvent[]
}

model BillingPayment {
  id                   String        @id @default(uuid())
  instituteId          String
  plan                 Tier?
  creditPackId         String?
  amountPaise          Int
  billingCycle         BillingCycle?
  status               String        @default("PENDING")
  providerOrderId      String        @unique
  providerPaymentId    String?       @unique
  providerSignature    String?
  verifiedAt           DateTime?
  verificationFailedAt DateTime?
  capturedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  institute            Institute     @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  @@index([instituteId, createdAt])
  @@index([status, createdAt])
}

model OnboardingPayment {
  id                     String       @id @default(uuid())
  providerOrderId        String       @unique
  providerPaymentId      String?      @unique
  providerSignature      String?
  amountPaise            Int
  currency               String       @default("INR")
  plan                   Tier
  billingCycle           BillingCycle
  onboardingLinkId       String?
  provisioningData       Json
  status                 String       @default("PENDING")
  provisionedInstituteId String?
  verifiedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([status, createdAt])
}

model PlanTrialClaim {
  id                String    @id @default(uuid())
  instituteId       String    @unique
  ownerIdentityHash String    @unique @db.VarChar(128)
  plan              Tier
  claimedAt         DateTime  @default(now())
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  institute         Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  @@index([plan, endsAt])
}

model BillingWebhookEvent {
  id              String     @id @default(uuid())
  instituteId     String?
  providerEventId String     @unique
  eventType       String
  payload         Json
  status          String     @default("RECEIVED")
  receivedAt      DateTime   @default(now())
  processedAt     DateTime?
  processingError String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  institute       Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([instituteId, receivedAt])
}

model PlanNotification {
  id             String    @id @default(uuid())
  instituteId    String
  event          String
  eventKey       String
  channel        String
  scheduledAt    DateTime
  status         String    @default("PENDING")
  transportJobId String?
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, eventKey, channel])
  @@index([status, scheduledAt])
}

model InviteToken {
  id          String    @id @default(uuid())
  token       String    @unique
  instituteId String
  isUsed      Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id])
}

model Admin {
  id                             String                          @id @default(uuid())
  username                       String                          @unique
  password                       String
  passwordVersion                Int                             @default(1)
  instituteId                    String?
  role                           String                          @default("INSTITUTE_ADMIN")
  institute                      Institute?                      @relation(fields: [instituteId], references: [id])
  batches                        Batch[]
  tests                          Test[]
  manualAttendanceRecords        AttendanceRecord[]              @relation("ManualAttendanceBy")
  refreshTokens                  RefreshToken[]
  onlineQuizzes                  OnlineQuiz[]
  marketplaceClaimsDecided       MarketplaceClaim[]              @relation("MarketplaceClaimsDecided")
  marketplaceAuditLogsAuthored   MarketplaceAuditLog[]           @relation("MarketplaceAuditLogsAuthored")
  superAdminAuditLogs            SuperAdminAuditLog[]
  superAdminReauthChallenges     SuperAdminReauthChallenge[]
  superAdminSupportSessions      SuperAdminSupportSession[]
  authenticationEvents           AuthenticationEvent[]
  adminSessions                  AdminSession[]
  superAdminIdempotencyRecords   SuperAdminIdempotencyRecord[]
  superAdminBillingOperations    SuperAdminBillingOperation[]
  superAdminOnboardingOperations SuperAdminOnboardingOperation[]
  supportMessages                SupportMessage[]
  internalCaseNotes              InternalCaseNote[]
  targetedCommunicationSends     TargetedCommunicationSend[]
  deletionRequests               SuperAdminDeletionRequest[]
  monthCoverageProfilesConfirmed StudentMonthCoverageProfile[] @relation("MonthCoverageProfileConfirmer")
  monthCoveragePaymentsCreated   MonthCoveragePayment[]          @relation("MonthCoveragePaymentCreator")
  monthCoveragePaymentsVoided    MonthCoveragePayment[]          @relation("MonthCoveragePaymentVoider")
  monthCoverageAuditEvents       MonthCoverageAuditEvent[]       @relation("MonthCoverageAuditActor")
}

model Batch {
  id                  String               @id @default(uuid())
  name                String
  subject             String?
  className           String?
  timeSlot            String?
  feeAmount           Float                @default(0)
  whatsappGroupLink   String?
  autoSendWelcome     Boolean              @default(false)
  isRegistrationOpen  Boolean              @default(true)
  isRegistrationEnded Boolean              @default(false)
  batchNumber         Int?
  startDate           DateTime?
  endDate             DateTime?
  teacherId           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  instituteId         String?
  institute           Institute?           @relation(fields: [instituteId], references: [id])
  teacher             Admin?               @relation(fields: [teacherId], references: [id])
  feeInstallments     FeeInstallment[]
  students            Student[]
  attendanceRecords   AttendanceRecord[]
  attendanceSweepRuns AttendanceSweepRun[]
  studentLeads        StudentLead[]
  tests               Test[]
  sharedTests         Test[]               @relation("TestBatches")
  onlineQuizzes       OnlineQuiz[]
  sharedOnlineQuizzes OnlineQuiz[]         @relation("OnlineQuizBatches")
  monthCoverageProfiles StudentMonthCoverageProfile[]
  monthCoveragePayments MonthCoveragePayment[]
  monthCoverageAllocations MonthCoverageAllocation[]

  @@index([teacherId, className])
  @@index([instituteId])
}

model Student {
  id                      String                     @id @default(uuid())
  humanId                 String?
  name                    String
  parentName              String
  parentWhatsapp          String
  parentEmail             String?
  status                  String                     @default("PENDING") // PENDING, ACTIVE, LEFT
  leaveReason             String?
  leftAt                  DateTime?
  batchId                 String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  schoolName              String?
  additionalData          Json?
  instituteId             String?
  feePayments             FeePayment[]
  feeInstallments         FeeInstallment[]
  feeAssignments          FeeInstallmentAssignment[]
  fees                    FeeRecord[]
  marks                   Mark[]
  attendanceRecords       AttendanceRecord[]
  batch                   Batch?                     @relation(fields: [batchId], references: [id])
  institute               Institute?                 @relation(fields: [instituteId], references: [id])
  balance                 StudentBalance?
  upiPaymentVerifications UpiPaymentVerification[]
  quizSubmissions         QuizSubmission[]
  monthCoverageProfile    StudentMonthCoverageProfile?
  monthCoveragePayments   MonthCoveragePayment[]
  monthCoverageAllocations MonthCoverageAllocation[]

  @@unique([humanId, instituteId])
  @@unique([name, parentWhatsapp, batchId], name: "student_natural_key")
  @@index([batchId])
  @@index([status])
  @@index([name])
  @@index([batchId, status])
  @@index([createdAt])
  @@index([instituteId, status])
  @@index([instituteId, createdAt])
  @@index([instituteId, parentWhatsapp])
}

model StudentMonthCoverageProfile {
  id                 String                     @id @default(uuid())
  instituteId        String
  batchId            String
  studentId          String                     @unique
  feeStartMonth      String?                    @db.VarChar(7)
  feeEndMonth        String?                    @db.VarChar(7)
  status             MonthCoverageProfileStatus @default(PENDING_SETUP)
  confirmedAt        DateTime?
  confirmedById      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  institute          Institute                  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch              Batch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student            Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  confirmedBy        Admin?                     @relation("MonthCoverageProfileConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([instituteId, status])
  @@index([batchId, status])
}

model MonthCoveragePayment {
  id             String                     @id @default(uuid())
  instituteId    String
  batchId        String
  studentId      String
  amountPaise    Int
  paymentDate    DateTime
  paymentMethod  String                     @db.VarChar(32)
  duration       MonthCoverageDuration
  note           String?
  status         MonthCoveragePaymentStatus @default(ACTIVE)
  idempotencyKey String
  createdById    String
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  institute      Institute                  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch          Batch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student        Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy      Admin                      @relation("MonthCoveragePaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy       Admin?                     @relation("MonthCoveragePaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  allocations    MonthCoverageAllocation[]
  auditEvents    MonthCoverageAuditEvent[]

  @@unique([instituteId, idempotencyKey])
  @@index([studentId, paymentDate])
  @@index([instituteId, status, paymentDate])
}

model MonthCoverageAllocation {
  id            String               @id @default(uuid())
  instituteId   String
  batchId       String
  studentId     String
  paymentId     String
  coverageMonth String               @db.VarChar(7)
  createdAt     DateTime             @default(now())
  payment       MonthCoveragePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch         Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, coverageMonth])
  @@index([instituteId, coverageMonth])
  @@index([batchId, coverageMonth])
  @@index([paymentId])
}

model MonthCoverageAuditEvent {
  id          String               @id @default(uuid())
  instituteId String
  paymentId   String
  actorId     String
  action      String               @db.VarChar(16)
  reason      String?
  before      Json?
  after       Json?
  createdAt   DateTime             @default(now())
  payment     MonthCoveragePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  institute   Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  actor       Admin                @relation("MonthCoverageAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([instituteId, createdAt])
}

model FeeRecord {
  id        String   @id @default(uuid())
  amount    Float
  date      DateTime @default(now())
  status    String   @default("PAID")
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([date])
}

model Test {
  id          String     @id @default(uuid())
  name        String
  subject     String
  className   String?
  date        DateTime
  maxMarks    Float
  teacherId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  instituteId String?
  batchId     String?
  isQuiz      Boolean    @default(false)
  marks       Mark[]
  institute   Institute? @relation(fields: [instituteId], references: [id])
  teacher     Admin?     @relation(fields: [teacherId], references: [id])
  batch       Batch?     @relation(fields: [batchId], references: [id])
  batches     Batch[]    @relation("TestBatches")

  @@index([teacherId])
  @@index([date])
  @@index([instituteId])
  @@index([batchId])
}

model Mark {
  id        String  @id @default(uuid())
  score     Float
  studentId String
  testId    String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
  @@index([testId])
  @@index([studentId])
}

model FeeInstallment {
  id                      String                     @id @default(uuid())
  name                    String
  amount                  Float
  batchId                 String
  studentId               String?
  createdAt               DateTime                   @default(now())
  batch                   Batch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student                 Student?                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments                FeePayment[]
  assignments             FeeInstallmentAssignment[]
  upiPaymentVerifications UpiPaymentVerification[]

  @@index([batchId])
  @@index([studentId])
}

model FeePayment {
  id            String         @id @default(uuid())
  date          DateTime       @default(now())
  amountPaid    Float
  studentId     String
  installmentId String
  createdAt     DateTime       @default(now())
  installment   FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([installmentId])
  @@index([studentId, installmentId])
  @@index([date])
  @@index([date, installmentId])
}

model FeeInstallmentAssignment {
  id            String         @id @default(uuid())
  studentId     String
  installmentId String
  createdAt     DateTime       @default(now())
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installment   FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, installmentId])
  @@index([studentId])
  @@index([installmentId])
}

model StudentBalance {
  studentId       String    @id
  totalFee        Float     @default(0)
  totalPaid       Float     @default(0)
  balance         Float     @default(0)
  lastPaymentDate DateTime?
  updatedAt       DateTime  @default(now())
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([balance], map: "idx_balance_desc")
  @@index([updatedAt])
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  studentId         String
  batchId           String
  instituteId       String
  attendanceDate    DateTime
  checkedInAt       DateTime         @default(now())
  photoStorageKey   String?
  photoUrl          String?
  photoUrlExpiresAt DateTime?
  photoMimeType     String?
  note              String?
  source            AttendanceSource @default(KIOSK)
  manualMarkedById  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch             Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute         Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  manualMarkedBy    Admin?           @relation("ManualAttendanceBy", fields: [manualMarkedById], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([batchId, attendanceDate, checkedInAt])
  @@index([instituteId, attendanceDate, checkedInAt])
}

model AttendanceSweepRun {
  id             String    @id @default(uuid())
  batchId        String
  instituteId    String
  attendanceDate DateTime
  scheduledFor   DateTime
  status         String    @default("COMPLETED")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([batchId, attendanceDate])
  @@index([scheduledFor])
  @@index([instituteId, attendanceDate])
}

model IdCounter {
  prefix String @id
  seq    Int
}

model EmailJob {
  id                   String    @id @default(uuid())
  recipient            String
  subject              String
  body                 String
  status               JobStatus @default(PENDING)
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  error                String?
  options              Json?
  instituteId          String?
  superAdminEntityType String?
  superAdminEntityId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([superAdminEntityType, superAdminEntityId, createdAt])
}

model WhatsappJob {
  id                    String    @id @default(uuid())
  recipient             String
  templateId            String
  data                  Json
  status                JobStatus @default(PENDING)
  attempts              Int       @default(0)
  maxAttempts           Int       @default(3)
  error                 String?
  messageId             String?
  instituteId           String?
  marketplaceEntityType String?
  marketplaceEntityId   String?
  superAdminEntityType  String?
  superAdminEntityId    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([status, attempts, createdAt], map: "idx_whatsapp_queue")
  @@index([marketplaceEntityType, marketplaceEntityId, createdAt], map: "idx_whatsapp_marketplace_entity")
  @@index([superAdminEntityType, superAdminEntityId, createdAt])
}

model OcrScanCache {
  imageHash String   @id
  result    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AdminOnboardingLink {
  id                      String   @id @default(uuid())
  token                   String   @unique
  plan                    String
  billingCycle            String?
  maxStudents             Int      @default(100)
  status                  String   @default("PENDING")
  instituteId             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  expiresAt               DateTime
  customPriceMonthlyPaise Int?
  customPriceYearlyPaise  Int?
  discountPercent         Int      @default(0)
  isFreeTrial             Boolean  @default(false)
  trialDays               Int?

  @@index([token])
  @@index([status])
  @@index([createdAt])
}

model OnboardingLead {
  id            String   @id @default(uuid())
  tuitionName   String?
  ownerName     String?
  phone         String   @unique
  email         String?
  planId        String?
  billingCycle  String?
  step          String   @default("STEP_1_STARTED")
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([step])
  @@index([createdAt])
}

// OTP tokens stored in DB instead of in-memory Map
// Survives server restarts and works across multiple Heroku dynos
model OtpToken {
  id         String   @id @default(uuid())
  identifier String // Phone number or email (normalized)
  otp        String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([identifier]) // One active OTP per identifier (upsert replaces old)
  @@index([expiresAt]) // For cleanup queries
}

// Refresh tokens for secure JWT rotation
model RefreshToken {
  id        String        @id @default(uuid())
  token     String        @unique
  adminId   String
  sessionId String?
  admin     Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  session   AdminSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
  @@index([sessionId])
  @@index([expiresAt])
}

model SuperAdminAuditLog {
  id               String   @id @default(uuid())
  action           String
  entityType       String
  entityId         String?
  actorAdminId     String
  instituteId      String?
  reason           String?
  correlationId    String
  supportSessionId String?
  before           Json?
  after            Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  actorAdmin       Admin    @relation(fields: [actorAdminId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([instituteId, createdAt])
  @@index([actorAdminId, createdAt])
}

model SuperAdminReauthChallenge {
  id          String    @id @default(uuid())
  adminId     String
  actionClass String
  otpHash     String
  attempts    Int       @default(0)
  lockedAt    DateTime?
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, actionClass, expiresAt])
}

model SuperAdminSupportSession {
  id           String         @id @default(uuid())
  adminId      String
  instituteId  String
  ticketId     String?
  caseId       String?
  reason       String
  expiresAt    DateTime
  endedAt      DateTime?
  endReason    String?
  createdAt    DateTime       @default(now())
  admin        Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  institute    Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  ticket       SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  internalCase InternalCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([adminId, expiresAt])
  @@index([instituteId, createdAt])
}

model SupportTicket {
  id              String                     @id @default(uuid())
  reference       String                     @unique
  instituteId     String
  category        String
  subject         String
  description     String                     @db.Text
  priority        String                     @default("NORMAL")
  status          String                     @default("NEW")
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  institute       Institute                  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  supportSessions SuperAdminSupportSession[]

  @@index([status, priority, createdAt])
  @@index([instituteId, updatedAt])
}

model SupportMessage {
  id            String        @id @default(uuid())
  ticketId      String
  authorAdminId String?
  visibility    String
  body          String        @db.Text
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorAdmin   Admin?        @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SupportAttachment {
  id          String        @id @default(uuid())
  ticketId    String
  storageKey  String        @unique
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model InternalCase {
  id              String                     @id @default(uuid())
  instituteId     String
  title           String
  category        String
  priority        String                     @default("NORMAL")
  status          String                     @default("OPEN")
  followUpAt      DateTime?
  linkedType      String?
  linkedId        String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  institute       Institute                  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  notes           InternalCaseNote[]
  supportSessions SuperAdminSupportSession[]

  @@index([status, followUpAt])
  @@index([instituteId, updatedAt])
}

model InternalCaseNote {
  id            String       @id @default(uuid())
  caseId        String
  authorAdminId String
  body          String       @db.Text
  createdAt     DateTime     @default(now())
  internalCase  InternalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorAdmin   Admin        @relation(fields: [authorAdminId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model InstituteCommunicationPreference {
  instituteId         String    @id
  whatsappOperational Boolean   @default(false)
  whatsappConsentedAt DateTime?
  emailOperational    Boolean   @default(false)
  emailConsentedAt    DateTime?
  consentSource       String?
  updatedAt           DateTime  @updatedAt
  institute           Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
}

model TargetedCommunicationSend {
  id                 String                           @id @default(uuid())
  channel            String
  templateName       String
  audienceDefinition Json
  reason             String
  idempotencyKey     String                           @unique
  status             String                           @default("DRAFT")
  includedCount      Int                              @default(0)
  excludedCount      Int                              @default(0)
  createdByAdminId   String
  dispatchedAt       DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  createdByAdmin     Admin                            @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  recipients         TargetedCommunicationRecipient[]

  @@index([status, createdAt])
}

model TargetedCommunicationRecipient {
  id              String                    @id @default(uuid())
  sendId          String
  instituteId     String?
  destination     String
  variables       Json
  status          String                    @default("PENDING")
  exclusionReason String?
  jobId           String?
  error           String?
  sentAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  send            TargetedCommunicationSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  institute       Institute?                @relation(fields: [instituteId], references: [id], onDelete: SetNull)

  @@unique([sendId, instituteId])
  @@index([status, createdAt])
  @@index([instituteId, createdAt])
}

model AuthenticationEvent {
  id          String   @id @default(uuid())
  adminId     String?
  eventType   String
  success     Boolean
  ipHash      String?
  deviceLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([eventType, success, createdAt])
}

model AdminSession {
  id            String         @id @default(uuid())
  adminId       String
  deviceLabel   String?
  ipHash        String?
  lastSeenAt    DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  admin         Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([adminId, revokedAt, expiresAt])
}

model SuperAdminIdempotencyRecord {
  id           String   @id @default(uuid())
  actorAdminId String
  scope        String
  key          String
  requestHash  String
  status       String   @default("PENDING")
  response     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  actorAdmin   Admin    @relation(fields: [actorAdminId], references: [id], onDelete: Cascade)

  @@unique([actorAdminId, scope, key])
  @@index([expiresAt])
}

model SuperAdminBillingOperation {
  id             String     @id @default(uuid())
  instituteId    String?
  actorAdminId   String
  type           String
  idempotencyKey String     @unique
  reason         String
  request        Json
  result         Json?
  status         String     @default("PENDING")
  effectiveAt    DateTime?
  appliedAt      DateTime?
  error          String?
  attempts       Int        @default(0)
  maxAttempts    Int        @default(3)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  institute      Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  actorAdmin     Admin      @relation(fields: [actorAdminId], references: [id])

  @@index([instituteId, createdAt])
  @@index([status, effectiveAt])
  @@index([actorAdminId, createdAt])
}

model SuperAdminOnboardingOperation {
  id             String                    @id @default(uuid())
  actorAdminId   String
  kind           String
  idempotencyKey String                    @unique
  requestHash    String
  status         String                    @default("PENDING")
  result         Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  actorAdmin     Admin                     @relation(fields: [actorAdminId], references: [id])
  rows           SuperAdminOnboardingRow[]

  @@index([actorAdminId, createdAt])
}

model SuperAdminDeletionRequest {
  id                          String     @id @default(uuid())
  instituteId                 String?
  requestedById               String
  reason                      String
  instituteName               String
  previousInstituteStatus     String
  previousRegistrationsPaused Boolean    @default(false)
  status                      String     @default("SCHEDULED")
  eligibleAt                  DateTime
  cancelledAt                 DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  institute                   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  requestedBy                 Admin      @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, eligibleAt])
  @@index([instituteId, createdAt])
}

model SuperAdminOnboardingRow {
  id          String                        @id @default(uuid())
  operationId String
  rowNumber   Int
  requestHash String
  status      String                        @default("PENDING")
  instituteId String?
  result      Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  operation   SuperAdminOnboardingOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, rowNumber])
  @@index([status, updatedAt])
}

enum Tier {
  FREE
  PRO
  ENTERPRISE
  NO_PLAN
  BASIC
  MARKETPLACE
  QUIZ
}

enum CoachingFeeMode {
  CURRENT_DUE_BASED
  MONTH_COVERAGE
}

enum MonthCoverageDuration {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum MonthCoveragePaymentStatus {
  ACTIVE
  VOID
}

enum MonthCoverageProfileStatus {
  PENDING_SETUP
  ACTIVE
  CLOSED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AttendanceSource {
  KIOSK
  MANUAL
}

model SystemAlert {
  id        String    @id @default(uuid())
  title     String
  message   String
  type      String    @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([isActive])
}

model StudentLead {
  id              String    @id @default(uuid())
  studentName     String
  parentName      String
  parentPhone     String
  batchInterestId String?
  status          String    @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  instituteId     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institute       Institute @relation(fields: [instituteId], references: [id])
  batch           Batch?    @relation(fields: [batchInterestId], references: [id])

  @@index([instituteId])
  @@index([status])
}

model SystemLog {
  id          String   @id @default(uuid())
  instituteId String
  action      String // E.g., STUDENT_JOIN, STUDENT_LEAVE, FEE_COLLECTED
  entityId    String? // Optional reference ID
  entityName  String? // Human readable name (e.g., Student Name, Batch Name)
  details     Json? // Optional structured details
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, action])
  @@index([createdAt])
  @@index([instituteId, action, createdAt])
}

model UpiPaymentVerification {
  id              String   @id @default(uuid())
  studentId       String
  instituteId     String
  installmentId   String? // Null if paying custom amount, assigned if paying specific installment
  amount          Float
  storageKey      String // The S3 or local path key of the screenshot
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  paidByName      String? // Name of person who made the payment
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute   Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  installment FeeInstallment? @relation(fields: [installmentId], references: [id])

  @@index([instituteId, status])
  @@index([studentId])
}

model OnlineQuiz {
  id             String    @id @default(uuid())
  title          String
  topic          String?
  difficulty     String?
  timeLimitMins  Int       @default(30)
  totalMarks     Float
  availableFrom  DateTime?
  availableUntil DateTime?
  isFinalized    Boolean   @default(false)
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  instituteId String
  batchId     String?
  teacherId   String?

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher   Admin?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  batches              Batch[]          @relation("OnlineQuizBatches")
  studentQuestionCount Int?
  questions            QuizQuestion[]
  submissions          QuizSubmission[]

  @@index([instituteId])
  @@index([batchId])
  @@index([batchId, isFinalized])
  @@index([batchId, createdAt])
  @@index([batchId, availableFrom, availableUntil])
  @@index([teacherId, instituteId, createdAt])
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  questionText  String
  orderIndex    Int     @default(0)
  options       Json // Array of strings
  correctOption String // The exact string of the correct option
  marks         Float   @default(1)
  variantGroup  String? // Null = standalone; same value = sibling variants (one picked per student)

  quiz    OnlineQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, orderIndex])
  @@index([quizId, variantGroup])
}

model QuizSubmission {
  id                String    @id @default(uuid())
  quizId            String
  studentId         String
  score             Float? // Null if not yet graded/submitted
  autoSavedAnswers  Json      @default("{}")
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  shuffledQuestions Json?

  quiz           OnlineQuiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        QuizAnswer[]
  cheatingEvents CheatingEvent[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
  @@index([quizId, submittedAt])
}

model CheatingEvent {
  id           String   @id @default(uuid())
  submissionId String
  eventType    String
  metadata     Json?
  timestamp    DateTime @default(now())

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, timestamp])
  @@index([eventType])
}

model QuizAnswer {
  id             String  @id @default(uuid())
  submissionId   String
  questionId     String
  selectedOption String? // Null if they skipped it
  isCorrect      Boolean @default(false)
  marksObtained  Float   @default(0)

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model ShortUrl {
  id        String   @id // unique random code
  longUrl   String   @db.Text
  createdAt DateTime @default(now())
}

model Review {
  id              String    @id @default(uuid())
  instituteId     String
  reviewerName    String
  reviewerRole    String    @default("Student") // Student, Parent
  rating          Int // 1 to 5
  comment         String    @db.Text
  status          String    @default("APPROVED") // APPROVED, PENDING, REJECTED
  source          String    @default("MATHLOGS") // MATHLOGS, GOOGLE
  googleAuthorUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([rating])
}

model LeadInquiry {
  id                     String    @id @default(uuid())
  instituteId            String
  studentName            String
  phone                  String
  subject                String?
  classGrade             String?
  message                String?   @db.Text
  status                 String    @default("NEW") // NEW, CONTACTED, ENROLLED, CLOSED
  deliveryStatus         String    @default("HELD")
  destinationPhone       String?
  notificationJobId      String?
  notificationSentAt     DateTime?
  notificationError      String?
  notificationRetryCount Int       @default(0)
  releasedAt             DateTime?
  possibleDuplicate      Boolean   @default(false)
  duplicateOfId          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  institute              Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([createdAt])
}

model MarketplaceClaim {
  id                      String    @id @default(uuid())
  instituteId             String
  claimantName            String
  phone                   String
  normalizedPhone         String
  email                   String?
  proofNote               String?   @db.Text
  notes                   String?   @db.Text
  status                  String    @default("NEW")
  verificationNote        String?   @db.Text
  rejectionReason         String?   @db.Text
  contactedAt             DateTime?
  decidedAt               DateTime?
  decidedByAdminId        String?
  communicationStatus     String    @default("NOT_SENT")
  communicationSentAt     DateTime?
  communicationError      String?   @db.Text
  communicationRetryCount Int       @default(0)
  whatsappJobId           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  institute               Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  decidedByAdmin          Admin?    @relation("MarketplaceClaimsDecided", fields: [decidedByAdminId], references: [id])

  @@index([status, createdAt])
  @@index([instituteId, createdAt])
  @@index([instituteId, normalizedPhone, status])
}

model MarketplaceAuditLog {
  id           String     @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  actorAdminId String?
  instituteId  String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime   @default(now())
  actorAdmin   Admin?     @relation("MarketplaceAuditLogsAuthored", fields: [actorAdminId], references: [id])
  institute    Institute? @relation(fields: [instituteId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([instituteId, createdAt])
  @@index([createdAt])
}
