# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/mathlogs?schema=public"
DB_CONNECTION_LIMIT=50
DB_POOL_TIMEOUT=30

# JWT Secret for authentication tokens (REQUIRED)
# Generate with: openssl rand -base64 32
# CRITICAL: Use different secret in production!
JWT_SECRET="your-secret-key-here"

# Email Configuration (Optional - for fee reminders and WhatsApp invites)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server Configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS and QR code generation)
# IMPORTANT: Update this in production to your actual domain
CLIENT_URL=http://localhost:5173

# Marketplace WhatsApp templates (required for claim/lead delivery)
# Approved: body claimant_name, institute_name, login_url; optional dynamic URL button uses login_url.
WHATSAPP_TEMPLATE_MARKETPLACE_CLAIM_APPROVED=
# Rejected: body claimant_name, institute_name, rejection_reason, support_url; optional dynamic URL button uses support_url.
WHATSAPP_TEMPLATE_MARKETPLACE_CLAIM_REJECTED=
# Lead: body owner_name, institute_name, student_name, class_subject_summary, settings_url; optional dynamic URL button uses settings_url.
WHATSAPP_TEMPLATE_MARKETPLACE_LEAD=

# Redis Configuration (Production - Optional)
# Uncomment and configure for production deployments
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Backup Encryption (Production - Optional)
# GPG passphrase for encrypted database backups
# GPG_PASSPHRASE=your-secure-passphrase
# GPG_BACKUP_EMAIL=backup@yourdomain.com

# AWS Textract (Optional - for OCR comparison testing)
# Get credentials from AWS IAM console
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1

# Production Security (DO NOT USE IN DEVELOPMENT)
# These should be loaded from secrets manager in production
# See PRODUCTION_SECURITY_GUIDE.md for details
